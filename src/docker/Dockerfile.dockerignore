# Next to src/docker/Dockerfile (BuildKit reads <Dockerfile>.dockerignore; the context is the
# repository root). Only src/laravel, src/docker/ and the agent are needed to build the image
*
!src/docker/
!src/laravel/
!src/powershell/app.ps1
src/laravel/.env
src/laravel/.env.*
!src/laravel/.env.example
src/laravel/node_modules
src/laravel/vendor
src/laravel/public/build
src/laravel/public/hot
src/laravel/public/storage
src/laravel/storage/app/*
src/laravel/storage/framework/cache/*
src/laravel/storage/framework/sessions/*
src/laravel/storage/framework/views/*
src/laravel/storage/logs/*
src/laravel/storage/boilerplate_install.json
src/laravel/database/*.sqlite*
src/laravel/bootstrap/cache/*.php
src/laravel/.phpunit.result.cache
